%%{init: {"flowchart": {"wrappingWidth": 420}, "themeVariables": {"fontSize": "20px", "fontFamily": "Inter, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif", "primaryColor": "#e3f2fd", "primaryTextColor": "#1e293b", "primaryBorderColor": "#1a73e8", "lineColor": "#1a73e8", "secondaryColor": "#fff3e0", "tertiaryColor": "#e8f5e9", "background": "#ffffff", "edgeLabelBackground": "#ffffff", "clusterBkg": "#f5f7fa", "clusterBorder": "#e2e8f0", "titleColor": "#1a73e8"}}}%%
flowchart LR
    subgraph TRACKER["<b>Google Sheets</b>"]
        direction LR
        PROMPT["<b>🗣️ Natural-language goal</b><br/>Launch tracker"] --> TABLE["<b>📊 Project table</b><br/>Task + owner + deadline"]
        TABLE --> RULES["<b>⚙️ Controls</b><br/>Dropdowns + formula"]
        RULES --> CHECK["<b>🔍 Verify</b><br/>Known dates + statuses"]
    end
    subgraph DOC["<b>Google Docs</b>"]
        direction LR
        FACTS["<b>📌 Confirmed facts</b><br/>From tracker"] --> DRAFT["<b>✍️ Announcement draft</b><br/>Audience + call to action"]
        DRAFT --> REVIEW["<b>👤 Human review</b><br/>Dates + tone + approval"]
    end
    CHECK --> FACTS
    REVIEW --> READY["<b>✅ Ready to share</b>"]
    style PROMPT fill:#e3f2fd,stroke:#1a73e8
    style TABLE fill:#fff3e0,stroke:#e65100
    style RULES fill:#f3e5f5,stroke:#7b1fa2
    style CHECK fill:#e8f5e9,stroke:#2e7d32
    style FACTS fill:#e3f2fd,stroke:#1a73e8
    style DRAFT fill:#fff3e0,stroke:#e65100
    style REVIEW fill:#f3e5f5,stroke:#7b1fa2
    style READY fill:#e8f5e9,stroke:#2e7d32

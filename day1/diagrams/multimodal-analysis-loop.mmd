%%{init: {"flowchart": {"wrappingWidth": 420}, "themeVariables": {"fontSize": "20px", "fontFamily": "Inter, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif", "primaryColor": "#e3f2fd", "primaryTextColor": "#1e293b", "primaryBorderColor": "#1a73e8", "lineColor": "#1a73e8", "secondaryColor": "#fff3e0", "tertiaryColor": "#e8f5e9", "background": "#ffffff", "edgeLabelBackground": "#ffffff", "clusterBkg": "#f5f7fa", "clusterBorder": "#e2e8f0", "titleColor": "#1a73e8"}}}%%
flowchart LR
    subgraph MEDIA["<b>Media inputs</b>"]
        direction LR
        VIDEO["<b>🎥 YouTube video</b><br/>Audio + visuals"]
        IMAGE["<b>🖼️ Screenshot</b><br/>UI or flowchart"]
    end
    subgraph ANALYSIS["<b>Prompted analysis</b>"]
        direction LR
        VIDEOQ["<b>⏱️ Timestamp notes</b><br/>Claim + MM:SS"]
        IMAGEQ["<b>🧭 Visual flow</b><br/>Steps + friction"]
    end
    subgraph CHECK["<b>Human verification</b>"]
        direction LR
        ORIGINAL["<b>🔍 Check original</b><br/>Video seconds + pixels"] --> REPORT["<b>📋 Shareable notes</b><br/>Evidence + interpretation"]
        REPORT --> REFINE{"<b>Claim supported?</b>"}
        REFINE -- "no" --> REVISE["<b>⚠️ Mark uncertain</b><br/>Refine or omit"]
        REVISE -.-> ANALYSIS
        REFINE -- "yes" --> RESULT["<b>✅ Verified insight</b>"]
    end
    VIDEO --> VIDEOQ
    IMAGE --> IMAGEQ
    ANALYSIS --> CHECK
    style VIDEO fill:#e3f2fd,stroke:#1a73e8
    style IMAGE fill:#e3f2fd,stroke:#1a73e8
    style VIDEOQ fill:#fff3e0,stroke:#e65100
    style IMAGEQ fill:#fff3e0,stroke:#e65100
    style ORIGINAL fill:#f3e5f5,stroke:#7b1fa2
    style REPORT fill:#e8f5e9,stroke:#2e7d32
    style REFINE fill:#fff3e0,stroke:#e65100
    style REVISE fill:#fce4ec,stroke:#c62828
    style RESULT fill:#e8f5e9,stroke:#2e7d32

%%{init: {"flowchart": {"wrappingWidth": 420}, "themeVariables": {"fontSize": "20px", "fontFamily": "Inter, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif", "primaryColor": "#e3f2fd", "primaryTextColor": "#1e293b", "primaryBorderColor": "#1a73e8", "lineColor": "#1a73e8", "secondaryColor": "#fff3e0", "tertiaryColor": "#e8f5e9", "background": "#ffffff", "edgeLabelBackground": "#ffffff", "clusterBkg": "#f5f7fa", "clusterBorder": "#e2e8f0", "titleColor": "#1a73e8"}}}%%
flowchart LR
    subgraph INPUT["<b>Source</b>"]
        direction LR
        PDF[("<b>📄 Dense PDF</b><br/>Report + charts")]
    end
    subgraph EXTRACT["<b>Multi-step analysis</b>"]
        direction LR
        READ["<b>👁️ Read</b><br/>Text + visuals"] --> FIND["<b>🔎 Find claims</b><br/>One statistic per row"]
        FIND --> CONTEXT["<b>🧩 Add context</b><br/>Page + surrounding text"]
        CONTEXT --> CRITIQUE["<b>🧪 Critique method</b><br/>Assumptions + gaps"]
    end
    subgraph HANDOFF["<b>Reviewable output</b>"]
        direction LR
        TABLE["<b>📋 Structured table</b><br/>Claim + citation"] --> CHECK{"<b>Sample pages checked?</b>"}
        CHECK -- "no" --> FLAG["<b>⚠️ Flag ambiguity</b><br/>Missing or conflicting"]
        FLAG -.-> EXTRACT
        CHECK -- "yes" --> SHEET["<b>📊 Export to Sheets</b><br/>Verified working table"]
    end
    INPUT --> EXTRACT
    EXTRACT --> HANDOFF
    style PDF fill:#e3f2fd,stroke:#1a73e8
    style READ fill:#fff3e0,stroke:#e65100
    style FIND fill:#fff3e0,stroke:#e65100
    style CONTEXT fill:#f3e5f5,stroke:#7b1fa2
    style CRITIQUE fill:#f3e5f5,stroke:#7b1fa2
    style TABLE fill:#e8f5e9,stroke:#2e7d32
    style CHECK fill:#fff3e0,stroke:#e65100
    style FLAG fill:#fce4ec,stroke:#c62828
    style SHEET fill:#e8f5e9,stroke:#2e7d32

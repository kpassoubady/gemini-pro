%%{init: {"flowchart": {"wrappingWidth": 420}, "themeVariables": {"fontSize": "20px", "fontFamily": "Inter, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif", "primaryColor": "#e3f2fd", "primaryTextColor": "#1e293b", "primaryBorderColor": "#1a73e8", "lineColor": "#1a73e8", "secondaryColor": "#fff3e0", "tertiaryColor": "#e8f5e9", "background": "#ffffff", "edgeLabelBackground": "#ffffff", "clusterBkg": "#f5f7fa", "clusterBorder": "#e2e8f0", "titleColor": "#1a73e8"}}}%%
flowchart LR
    DRIVE["<b>Google Drive source</b><br/>owner edits original"] --> AUTO["<b>Automatic refresh</b><br/>every few minutes or on open"]
    AUTO --> COPY["<b>Notebook source</b><br/>updated imported content"]
    COPY --> CHECK{"<b>Current enough?</b>"}
    CHECK -- "no" --> MANUAL["<b>Manual sync</b><br/>request latest Drive content"]
    MANUAL --> COPY
    CHECK -- "yes" --> QUERY["<b>Ask question</b><br/>selected sources only"]
    QUERY --> EXPORT["<b>Exported artifact</b><br/>separate file and permissions"]

    style DRIVE fill:#e3f2fd,stroke:#1a73e8
    style AUTO fill:#fff3e0,stroke:#e65100
    style COPY fill:#1a237e,stroke:#1a237e,color:#ffffff
    style CHECK fill:#fff3e0,stroke:#e65100
    style MANUAL fill:#fce4ec,stroke:#c62828
    style QUERY fill:#f3e5f5,stroke:#7b1fa2
    style EXPORT fill:#e8f5e9,stroke:#2e7d32

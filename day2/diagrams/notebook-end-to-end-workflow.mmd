%%{init: {"flowchart": {"wrappingWidth": 420}, "themeVariables": {"fontSize": "20px", "fontFamily": "Inter, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif", "primaryColor": "#e3f2fd", "primaryTextColor": "#1e293b", "primaryBorderColor": "#1a73e8", "lineColor": "#1a73e8", "secondaryColor": "#fff3e0", "tertiaryColor": "#e8f5e9", "background": "#ffffff", "edgeLabelBackground": "#ffffff", "clusterBkg": "#f5f7fa", "clusterBorder": "#e2e8f0", "titleColor": "#1a73e8"}}}%%
flowchart LR
    subgraph CONTROL["<b>Control the evidence</b>"]
        direction LR
        DEFINE["<b>Define</b><br/>audience, decision, owner"] --> SOURCE["<b>Source</b><br/>permission and authority"] --> VERIFY["<b>Verify</b><br/>imports and citations"]
    end

    subgraph CREATE["<b>Create the deliverables</b>"]
        direction LR
        NOTES["<b>Curate</b><br/>verified notes"] --> GUIDE["<b>Transform</b><br/>study guide and media"] --> REVIEW["<b>Review</b><br/>facts and accessibility"]
    end

    subgraph OPERATE["<b>Operate the notebook</b>"]
        direction LR
        SHARE["<b>Share</b><br/>separate permissions"] --> MAINTAIN["<b>Maintain</b><br/>owner and review trigger"] --> ARCHIVE["<b>Archive</b><br/>retain or delete"]
    end

    CONTROL -.-> CREATE
    CREATE -.-> OPERATE

    style DEFINE fill:#e3f2fd,stroke:#1a73e8
    style SOURCE fill:#f3e5f5,stroke:#7b1fa2
    style VERIFY fill:#1a237e,stroke:#1a237e,color:#ffffff
    style NOTES fill:#f3e5f5,stroke:#7b1fa2
    style GUIDE fill:#fff3e0,stroke:#e65100
    style REVIEW fill:#fce4ec,stroke:#c62828
    style SHARE fill:#e8f5e9,stroke:#2e7d32
    style MAINTAIN fill:#fff3e0,stroke:#e65100
    style ARCHIVE fill:#e8f5e9,stroke:#2e7d32

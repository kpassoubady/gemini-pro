%%{init: {"flowchart": {"wrappingWidth": 420}, "themeVariables": {"fontSize": "20px", "fontFamily": "Inter, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif", "primaryColor": "#e3f2fd", "primaryTextColor": "#1e293b", "primaryBorderColor": "#1a73e8", "lineColor": "#1a73e8", "secondaryColor": "#fff3e0", "tertiaryColor": "#e8f5e9", "background": "#ffffff", "edgeLabelBackground": "#ffffff", "clusterBkg": "#f5f7fa", "clusterBorder": "#e2e8f0", "titleColor": "#1a73e8"}}}%%
flowchart LR
    FILES["<b>Source set</b><br/>Drive, files, web, audio"] --> PERMIT{"<b>Permitted and relevant?</b>"}
    PERMIT -- "no" --> REJECT["<b>Do not import</b><br/>replace or redact"]
    PERMIT -- "yes" --> IMPORT["<b>Import</b><br/>copy or synced version"]
    IMPORT --> INSPECT["<b>Inspect content</b><br/>completeness and transcription"]
    INSPECT --> LABEL["<b>Classify source</b><br/>authority, freshness, scope"]
    LABEL --> SELECT["<b>Select evidence set</b><br/>focus the current question"]
    SELECT --> ANSWER["<b>Grounded response</b><br/>verify claim and citation"]

    style FILES fill:#e3f2fd,stroke:#1a73e8
    style PERMIT fill:#fff3e0,stroke:#e65100
    style REJECT fill:#fce4ec,stroke:#c62828
    style IMPORT fill:#1a237e,stroke:#1a237e,color:#ffffff
    style INSPECT fill:#fff3e0,stroke:#e65100
    style LABEL fill:#f3e5f5,stroke:#7b1fa2
    style SELECT fill:#f3e5f5,stroke:#7b1fa2
    style ANSWER fill:#e8f5e9,stroke:#2e7d32

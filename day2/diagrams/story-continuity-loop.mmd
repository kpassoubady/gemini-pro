%%{init: {"flowchart": {"wrappingWidth": 420}, "themeVariables": {"fontSize": "20px", "fontFamily": "Inter, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif", "primaryColor": "#e3f2fd", "primaryTextColor": "#1e293b", "primaryBorderColor": "#1a73e8", "lineColor": "#1a73e8", "secondaryColor": "#fff3e0", "tertiaryColor": "#e8f5e9", "background": "#ffffff", "edgeLabelBackground": "#ffffff", "clusterBkg": "#f5f7fa", "clusterBorder": "#e2e8f0", "titleColor": "#1a73e8"}}}%%
flowchart LR
    BIBLE["<b>Story bible</b><br/>identity, style, fixed details"] --> ANCHOR["<b>Anchor keyframe</b><br/>approved visual reference"]
    ANCHOR --> DELTA["<b>Scene delta</b><br/>describe only the change"]
    DELTA --> DRAFT["<b>Draft next frame</b><br/>use reference images"]
    DRAFT --> CHECK{"<b>Continuity passes?</b>"}
    CHECK -- "no" --> LEDGER["<b>Record drift</b><br/>character, prop, style, geography"]
    LEDGER --> DELTA
    CHECK -- "yes" --> APPROVE["<b>Approve frame</b><br/>new reference for next scene"]
    APPROVE --> DELTA

    style BIBLE fill:#e3f2fd,stroke:#1a73e8
    style ANCHOR fill:#1a237e,stroke:#1a237e,color:#ffffff
    style DELTA fill:#f3e5f5,stroke:#7b1fa2
    style DRAFT fill:#fff3e0,stroke:#e65100
    style CHECK fill:#fff3e0,stroke:#e65100
    style LEDGER fill:#fce4ec,stroke:#c62828
    style APPROVE fill:#e8f5e9,stroke:#2e7d32

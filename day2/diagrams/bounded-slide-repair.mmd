%%{init: {"flowchart": {"wrappingWidth": 420}, "themeVariables": {"fontSize": "20px", "fontFamily": "Inter, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif", "primaryColor": "#e3f2fd", "primaryTextColor": "#1e293b", "primaryBorderColor": "#1a73e8", "lineColor": "#1a73e8", "secondaryColor": "#fff3e0", "tertiaryColor": "#e8f5e9", "background": "#ffffff", "edgeLabelBackground": "#ffffff", "clusterBkg": "#f5f7fa", "clusterBorder": "#e2e8f0", "titleColor": "#1a73e8"}}}%%
flowchart LR
    DEFECT["<b>Name one defect</b><br/>density, hierarchy, layout"] --> BOUND["<b>Bound the repair</b><br/>change and preserve rules"]
    BOUND --> PREVIEW["<b>Generate preview</b><br/>do not replace yet"]
    PREVIEW --> CHECK{"<b>Acceptance check passes?</b>"}
    CHECK -- "no" --> DIAGNOSE["<b>Identify regression</b><br/>fact, layout, accessibility"]
    DIAGNOSE --> BOUND
    CHECK -- "yes" --> REPLACE["<b>Replace slide</b><br/>retain editable elements"]
    REPLACE --> NARRATIVE["<b>Review full deck</b><br/>preserve story and intent"]

    style DEFECT fill:#e3f2fd,stroke:#1a73e8
    style BOUND fill:#f3e5f5,stroke:#7b1fa2
    style PREVIEW fill:#1a237e,stroke:#1a237e,color:#ffffff
    style CHECK fill:#fff3e0,stroke:#e65100
    style DIAGNOSE fill:#fce4ec,stroke:#c62828
    style REPLACE fill:#e8f5e9,stroke:#2e7d32
    style NARRATIVE fill:#e8f5e9,stroke:#2e7d32

%%{init: {"flowchart": {"wrappingWidth": 420}, "themeVariables": {"fontSize": "20px", "fontFamily": "Inter, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif", "primaryColor": "#e3f2fd", "primaryTextColor": "#1e293b", "primaryBorderColor": "#1a73e8", "lineColor": "#1a73e8", "secondaryColor": "#fff3e0", "tertiaryColor": "#e8f5e9", "background": "#ffffff", "edgeLabelBackground": "#ffffff", "clusterBkg": "#f5f7fa", "clusterBorder": "#e2e8f0", "titleColor": "#1a73e8"}}}%%
flowchart LR
    CLAIM["<b>Generated claim</b>"] --> CITE["<b>Open citation</b><br/>quote in context"]
    CITE --> SUPPORT{"<b>Passage supports all of it?</b>"}
    SUPPORT -- "yes" --> AUTH{"<b>Source has authority?</b>"}
    SUPPORT -- "partly" --> PARTIAL["<b>Mark partial</b><br/>split or narrow claim"]
    SUPPORT -- "no" --> REJECT["<b>Contradicted or unsupported</b><br/>remove or investigate"]
    AUTH -- "yes" --> VERIFIED["<b>Verified row</b><br/>retain qualifier and location"]
    AUTH -- "no" --> CONTEXT["<b>Context only</b><br/>find controlling source"]

    style CLAIM fill:#e3f2fd,stroke:#1a73e8
    style CITE fill:#1a237e,stroke:#1a237e,color:#ffffff
    style SUPPORT fill:#fff3e0,stroke:#e65100
    style AUTH fill:#fff3e0,stroke:#e65100
    style PARTIAL fill:#f3e5f5,stroke:#7b1fa2
    style REJECT fill:#fce4ec,stroke:#c62828
    style VERIFIED fill:#e8f5e9,stroke:#2e7d32
    style CONTEXT fill:#f3e5f5,stroke:#7b1fa2
